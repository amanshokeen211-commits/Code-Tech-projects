class MLPipeline:
    def __init__(self, config_path: str = 'config.yaml'):
        with open(config_path, 'r') as file:
            self.config = yaml.safe_load(file)
        
        self.loader = DataLoader(config_path)
        self.preprocessor = DataPreprocessor(config_path)
        self.transformer = DataTransformer(config_path)
        self.model = None
    
    def run_pipeline(self) -> dict:
        """Run the complete ML pipeline"""
        print("Starting ML Pipeline...")
        
        # Step 1: Load Data
        print("\n1. Loading Data...")
        df = self.loader.load_data()
        print(f"Original data shape: {df.shape}")
        
        # Step 2: Preprocess Data
        print("\n2. Preprocessing Data...")
        df_clean = self.preprocessor.handle_missing_values(df)
        df_clean = self.preprocessor.remove_outliers(df_clean)
        
        # Step 3: Feature Engineering
        print("\n3. Feature Engineering...")
        df_features = self.transformer.create_features(df_clean)
        
        # Step 4: Transform Data
        print("\n4. Transforming Data...")
        df_transformed = self.preprocessor.transform(df_features)
        
        # Step 5: Split Data
        print("\n5. Splitting Data...")
        X_train, X_test, y_train, y_test = self.transformer.split_data(df_transformed)
        
        # Step 6: Train Model
        print("\n6. Training Model...")
        model_config = self.config['model']
        if model_config['algorithm'] == 'random_forest':
            self.model = RandomForestClassifier(**model_config['params'])
        elif model_config['algorithm'] == 'logistic_regression':
            self.model = LogisticRegression()
        else:
            self.model = RandomForestClassifier()
        
        self.model.fit(X_train, y_train)
        
        # Step 7: Evaluate Model
        print("\n7. Evaluating Model...")
        results = self.evaluate_model(X_test, y_test)
        
        # Step 8: Save Artifacts
        print("\n8. Saving Artifacts...")
        self.save_artifacts(df_transformed, X_test, y_test)
        
        return results
    
    def evaluate_model(self, X_test: pd.DataFrame, y_test: pd.Series) -> dict:
        """Evaluate the trained model"""
        y_pred = self.model.predict(X_test)
        y_pred_proba = self.model.predict_proba(X_test)[:, 1]
        
        # Calculate metrics
        accuracy = self.model.score(X_test, y_test)
        auc_score = roc_auc_score(y_test, y_pred_proba)
        
        print(f"Accuracy: {accuracy:.4f}")
        print(f"AUC Score: {auc_score:.4f}")
        print("\nClassification Report:")
